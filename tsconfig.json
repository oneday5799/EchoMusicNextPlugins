{
  "compilerOptions": {
    "target": "ES2016",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2016"],
    "types": ["@echomusicnext/plugin-sdk"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false
  },
  "include": ["plugins/**/*.ts", "tests/types/**/*.ts"]
}
